# General Crawler Settings
BASE_URL=https://immi.homeaffairs.gov.au/visas/working-in-australia/skill-occupation-list
CONCURRENCY=4
OUTPUT_DIR=output
PAGE_LOAD_TIMEOUT=30000

# Infrastructure Links
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/immi_crawler

# Output Format: json, csv, sqlite, postgres
OUTPUT_FORMAT=postgres

# Alert Notifications: email, telegram, both
NOTIFIER_BACKEND=email

# SMTP Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=crawler@example.com
SMTP_RECIPIENT=admin@example.com

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
