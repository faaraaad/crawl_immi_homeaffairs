# ==========================================
# Python Specific
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / Coverage / Linting caches
htmlcov/
.tox/
.nosenv/
.nosetests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log

# Environments
.venv
venv/
env/
ENV/
env.bak/
venv.bak/

# mypy / pytype / pyre
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Celery
celerybeat-schedule
celerybeat.pid

# ==========================================
# Operating System & IDE Specific
# ==========================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Docker local state/cache
.docker/

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/code-workspace
.history/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iws
*.iml
*.ipr

# ==========================================
# Project-Specific Ignores
# ==========================================
# Environment secrets (ignores active configs but allows example configs)
.env
.env.*
!.env.example

# Crawler output folder (ignores contents but tracks the directory via .gitkeep)
output/*
!output/.gitkeep

# Local packages (ignores contents but tracks the directory via .gitkeep)
local_packages/*
!local_packages/.gitkeep

# Local SQLite databases (in case SQLite output format is used)
*.db
*.sqlite
*.sqlite3
*.sqlite3-journal
